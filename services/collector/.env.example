# Backend only. Use a limited runtime role and TLS; migrations use a separate role.
DATABASE_URL=postgresql://collector_app:REPLACE@HOST/neondb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
MIGRATION_DATABASE_URL=postgresql://MIGRATION_ROLE:REPLACE@HOST/neondb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
PUBLIC_BASE_URL=https://YOUR-COLLECTOR-HOST
MAX_IMAGE_BYTES=12582912
MAX_IMAGE_DIMENSION=4096
MAX_EXPORT_SAMPLES=5000
DB_POOL_SIZE=4
# Neon branch storage cap in bytes; surfaced via /v1/health so clients can warn before hitting it.
DB_BYTE_LIMIT=1073741824
# Explicit opt-in ONLY for a development database on loopback.
ALLOW_LOCAL_DATABASE=0
